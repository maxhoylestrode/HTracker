PORT=3000
SESSION_SECRET=change-this-to-a-long-random-string
NODE_ENV=production
# Set to "true" only once your app is served over HTTPS (e.g. behind the nginx config)
TRUST_PROXY=true

# --- Monzo bank connection (optional) ---
# Only needed if you want to connect a Monzo account. Register a client at
# developers.monzo.com (type: confidential) with redirect URI
# https://<your-domain>/api/monzo/callback, then set the two values it gives you below.
# See docs/ADR-001-monzo-integration.md for the full picture.
#MONZO_CLIENT_ID=
#MONZO_CLIENT_SECRET=
# Only needed if the app can't correctly infer its own public URL (it usually can).
#APP_BASE_URL=https://tracker.apexstudio.dev
# Only needed if you want to pin/back up the key used to encrypt stored Monzo tokens —
# otherwise one is generated automatically on first boot.
#TOKEN_ENCRYPTION_KEY=
